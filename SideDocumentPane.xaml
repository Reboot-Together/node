<UserControl
    x:Class="AsterismApp.SideDocumentPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AsterismApp">
  <Border Background="#1E1E1E" BorderBrush="{StaticResource CardBorder}" BorderThickness="1,0,0,0" Padding="14,14,14,10">
    <Grid RowDefinitions="Auto,*" RowSpacing="10">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <StackPanel Spacing="2">
          <TextBlock x:Name="DocumentKindText" Text="SIDE NOTE" Foreground="{StaticResource Positive}" FontSize="{Binding Small, Source={StaticResource Typography}}" FontWeight="SemiBold" />
          <TextBox x:Name="TitleBox" Background="Transparent" BorderThickness="0" Padding="0,3" FontSize="{Binding Title, Source={StaticResource Typography}}" FontWeight="SemiBold" TextChanged="TitleBox_TextChanged" />
          <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedText}" FontSize="{Binding Small, Source={StaticResource Typography}}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
        </StackPanel>
        <Button Grid.Column="1" Content="×" Style="{StaticResource QuietButton}" Padding="7,4" MinWidth="0" VerticalAlignment="Top" Click="Close_Click" ToolTipService.ToolTip="옆 문서 닫기" AutomationProperties.Name="옆 문서 닫기" />
      </Grid>

      <Grid x:Name="Workspace" Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="PreviewRow" Height="2.125*" MinHeight="120" />
          <RowDefinition x:Name="DividerRow" Height="8" />
          <RowDefinition x:Name="EditorRow" Height="*" MinHeight="110" />
        </Grid.RowDefinitions>
        <WebView2 x:Name="Preview" Grid.Row="0" HorizontalAlignment="Stretch" DefaultBackgroundColor="#1E1E1E" />
        <Grid x:Name="Divider" Grid.Row="1" Background="Transparent" ToolTipService.ToolTip="드래그하여 미리보기와 편집기 높이 조절">
          <Border Height="1" Background="{StaticResource CardBorder}" VerticalAlignment="Center" IsHitTestVisible="False" />
          <local:VerticalResizeBorder Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Thumb Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" DragDelta="Divider_DragDelta" />
          </local:VerticalResizeBorder>
        </Grid>
        <Border x:Name="EditorContainer" Grid.Row="2" Background="#1E1E1E" BorderBrush="#303030" BorderThickness="1" CornerRadius="6">
          <TextBox x:Name="Editor" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#1E1E1E" Foreground="#D4D4D4" PlaceholderForeground="#858585" BorderThickness="0" CornerRadius="6" Padding="20,12" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" FontSize="{Binding Body, Source={StaticResource Typography}}" PlaceholderText="Markdown으로 자유롭게 쓰세요." TextChanged="Editor_TextChanged" KeyDown="Editor_KeyDown" Loaded="Editor_Loaded">
            <TextBox.Resources>
              <SolidColorBrush x:Key="TextControlBackground" Color="#1E1E1E" />
              <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1E1E1E" />
              <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1E1E" />
              <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
              <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
              <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
              <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#5A4B2A" />
              <SolidColorBrush x:Key="ScrollBarTrackBackground" Color="Transparent" />
              <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#555555" />
              <SolidColorBrush x:Key="ScrollBarThumbBackgroundPointerOver" Color="#707070" />
              <SolidColorBrush x:Key="ScrollBarThumbBackgroundPressed" Color="#808080" />
              <SolidColorBrush x:Key="ScrollBarButtonBackground" Color="Transparent" />
            </TextBox.Resources>
          </TextBox>
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
