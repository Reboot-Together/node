<Application
    x:Class="NodeApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
    </ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="AppBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarBackground" Color="#F6F6F4" />
    <SolidColorBrush x:Key="InspectorBackground" Color="#FAFAF9" />
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#E6E6E3" />
    <SolidColorBrush x:Key="MutedText" Color="#737373" />
    <SolidColorBrush x:Key="Accent" Color="#171717" />
    <SolidColorBrush x:Key="Positive" Color="#0D9F6E" />
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBackground}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#DEDEDA" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="AccentButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="QuietButton" TargetType="Button">
      <Setter Property="Background" Value="#F1F1EF" />
      <Setter Property="Foreground" Value="#242424" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
