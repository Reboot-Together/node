<Window
    x:Class="NodeApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NodeApp"
    Title="Node">
  <Grid x:Name="Root" RequestedTheme="Light" Background="{StaticResource AppBackground}" RowDefinitions="48,*">
    <Border Background="#FAFAF9" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="12,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Border Width="25" Height="25" Background="#ECECE9" CornerRadius="6">
            <TextBlock Text="◇" FontSize="12" Foreground="#303030" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Node" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="⌄" Foreground="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" />
          <Border Width="1" Height="17" Background="{StaticResource CardBorder}" Margin="4,0" />
          <TextBlock Text="Local markdown workspace" Foreground="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <TextBlock Text="로컬 · 자동 저장" Foreground="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBlock x:Name="CurrentVersionText" Foreground="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center" />
          <Button x:Name="UpdateButton" Content="업데이트" Style="{StaticResource QuietButton}" Padding="10,5" Click="UpdateVersions_Click" />
          <Button Content="오늘 노트" Style="{StaticResource QuietButton}" Padding="10,5" Click="DailyNote_Click" />
          <Button Content="＋ 새 노트" Style="{StaticResource AccentButton}" Padding="10,5" Click="NewNote_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="232,*,348">
      <Border Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0" Padding="10,12,9,10">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
          <Grid ColumnDefinitions="*,Auto" Margin="2,0">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="▱" Foreground="#5F5F5F" FontSize="12" />
              <TextBlock Text="노트" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
            <Button Grid.Column="1" Content="↻" Style="{StaticResource QuietButton}" Padding="7,3" MinWidth="0" Click="Refresh_Click" />
          </Grid>
          <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource Field}" PlaceholderText="⌕  제목, 본문 검색" TextChanged="Search_TextChanged" />
          <ListView x:Name="NoteList" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="NoteList_SelectionChanged" SelectionMode="Single" CanDragItems="True" DragItemsStarting="NoteList_DragItemsStarting" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,3" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="local:VaultItem">
                <Border Background="Transparent" CornerRadius="6" Padding="5,6" Tag="{x:Bind Path}" Tapped="VaultItem_Tapped" RightTapped="VaultItem_RightTapped" AllowDrop="True" DragOver="VaultItem_DragOver" Drop="VaultItem_Drop">
                  <Grid ColumnDefinitions="Auto,16,*" ColumnSpacing="3">
                    <Border Width="{x:Bind Indent}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Icon}" FontSize="13" Foreground="#777773" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="2" Spacing="2">
                      <TextBlock Text="{x:Bind Name}" FontSize="11" FontWeight="SemiBold" Foreground="#292929" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{x:Bind Subtitle}" FontSize="9" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <Border Grid.Row="3" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="2,10,2,0">
            <StackPanel Spacing="6">
              <TextBlock Text="저장소" Foreground="{StaticResource MutedText}" FontSize="9" />
              <TextBlock x:Name="StoragePathText" Text="표준 .md 파일로 저장됩니다." FontSize="9" Foreground="#3F3F3F" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Button Content="폴더 변경" Style="{StaticResource QuietButton}" Padding="8,4" Click="ChangeFolder_Click" />
                <Button Content="열기" Style="{StaticResource QuietButton}" Padding="8,4" Click="OpenFolder_Click" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="#FFFFFF" Padding="28,18,28,12">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
          <Grid>
            <StackPanel Spacing="2">
              <TextBlock Text="NOTE" Foreground="{StaticResource Positive}" FontFamily="Cascadia Mono" FontSize="9" FontWeight="SemiBold" />
              <TextBox x:Name="TitleBox" Background="Transparent" BorderThickness="0" Padding="0,3" FontSize="22" FontWeight="SemiBold" PlaceholderText="무엇을 기록할까요?" TextChanged="Editor_TextChanged" />
            </StackPanel>
          </Grid>
          <Border Grid.Row="1" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="7">
              <StackPanel Spacing="4"><TextBlock Text="분류" Foreground="{StaticResource MutedText}" FontSize="9" /><TextBox x:Name="CategoryBox" Style="{StaticResource Field}" PlaceholderText="Database" TextChanged="Editor_TextChanged" /></StackPanel>
              <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="출처" Foreground="{StaticResource MutedText}" FontSize="9" /><TextBox x:Name="SourceBox" Style="{StaticResource Field}" PlaceholderText="Manual" TextChanged="Editor_TextChanged" /></StackPanel>
              <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="유형" Foreground="{StaticResource MutedText}" FontSize="9" /><TextBox x:Name="TypeBox" Style="{StaticResource Field}" PlaceholderText="Study" TextChanged="Editor_TextChanged" /></StackPanel>
            </Grid>
          </Border>
          <Grid Grid.Row="2">
            <TextBox x:Name="Editor" Background="Transparent" BorderThickness="0" Padding="0,5" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono" FontSize="12" PlaceholderText="Markdown으로 자유롭게 쓰세요.&#x0a;&#x0a;[[다른 노트 제목]]을 입력하면 자동으로 연결됩니다." TextChanged="Editor_TextChanged" KeyDown="Editor_KeyDown" />
            <WebView2 x:Name="MarkdownPreview" Visibility="Collapsed" DefaultBackgroundColor="#FFFFFF" NavigationStarting="MarkdownPreview_NavigationStarting" />
          </Grid>
          <Border Grid.Row="3" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,9,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Markdown · 0.7초 후 자동 저장" Foreground="{StaticResource MutedText}" FontSize="9" />
              <TextBlock Grid.Column="1" Text="[[링크]]로 지식 연결" Foreground="{StaticResource Positive}" FontSize="9" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource InspectorBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1,0,0,0" Padding="12,13,12,10">
        <Grid RowDefinitions="Auto,Auto,92,*,Auto" RowSpacing="9">
          <StackPanel Spacing="2">
            <TextBlock Text="연결" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Text="현재 노트의 백링크와 로컬 그래프" Foreground="{StaticResource MutedText}" FontSize="9" />
          </StackPanel>
          <Border Grid.Row="1" Background="#F0F0EE" CornerRadius="6" Padding="9,7">
            <TextBlock x:Name="BacklinkTitle" Foreground="#343434" FontWeight="SemiBold" FontSize="10" />
          </Border>
          <ListView x:Name="BacklinkList" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="BacklinkList_SelectionChanged" SelectionMode="Single">
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,3" /><Setter Property="MinHeight" Value="0" /></Style></ListView.ItemContainerStyle>
            <ListView.ItemTemplate><DataTemplate x:DataType="local:NoteInfo"><Border Background="#EEEEEB" CornerRadius="5" Padding="8,6"><TextBlock Text="{x:Bind Title}" FontSize="10" Foreground="#333333" /></Border></DataTemplate></ListView.ItemTemplate>
          </ListView>
          <Grid Grid.Row="3" Margin="0,3,0,0" RowDefinitions="Auto,*" RowSpacing="6">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
              <TextBlock Text="로컬 그래프" FontWeight="SemiBold" FontSize="10" Foreground="#4F4F4F" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="−" Style="{StaticResource QuietButton}" Padding="7,2" MinWidth="0" Click="GraphZoomOut_Click" />
              <TextBlock x:Name="GraphZoomText" Grid.Column="2" Text="100%" Foreground="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center" Margin="7,0" />
              <Button Grid.Column="3" Content="＋" Style="{StaticResource QuietButton}" Padding="7,2" MinWidth="0" Click="GraphZoomIn_Click" />
            </Grid>
            <Border Grid.Row="1" Background="#F7F7F5" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="3">
              <ScrollViewer x:Name="GraphScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" ZoomMode="Disabled" SizeChanged="GraphScroll_SizeChanged">
                <Canvas x:Name="GraphCanvas" Width="1200" Height="800" Background="#F7F7F5" DoubleTapped="GraphCanvas_DoubleTapped" PointerWheelChanged="GraphCanvas_PointerWheelChanged" PointerPressed="GraphCanvas_PointerPressed" PointerMoved="GraphCanvas_PointerMoved" PointerReleased="GraphCanvas_PointerReleased" PointerCanceled="GraphCanvas_PointerReleased" PointerCaptureLost="GraphCanvas_PointerReleased" />
              </ScrollViewer>
            </Border>
          </Grid>
          <Expander Grid.Row="4" Header="ChatGPT 대화 가져오기" IsExpanded="True" FontSize="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="7" Padding="0,8,0,0" HorizontalAlignment="Stretch">
              <TextBox x:Name="ShareUrlBox" Style="{StaticResource Field}" PlaceholderText="공유 링크를 붙여 넣으세요" TextChanged="ShareUrl_TextChanged" />
              <Button x:Name="ImportButton" Content="가져오기" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="7" Padding="12,7" FontSize="12" IsEnabled="False" Click="ImportChat_Click">
                <Button.Resources>
                  <SolidColorBrush x:Key="ButtonBackground" Color="#171717" />
                  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#292929" />
                  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3A3A3A" />
                  <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FFFFFF" />
                  <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
                  <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                  <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                  <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#777773" />
                  <SolidColorBrush x:Key="ButtonBorderBrush" Color="#171717" />
                  <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#292929" />
                  <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#3A3A3A" />
                  <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#DEDEDA" />
                </Button.Resources>
              </Button>
            </StackPanel>
          </Expander>
        </Grid>
      </Border>
    </Grid>
    <WebView2 x:Name="ShareReader" Grid.Row="1" Width="1" Height="1" Opacity="0.01" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
  </Grid>
</Window>
